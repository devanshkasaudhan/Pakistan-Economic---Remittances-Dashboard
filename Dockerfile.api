FROM python:3.11-slim

WORKDIR /app

# Only install what the backend ML processing requires
RUN pip install --no-cache-dir fastapi uvicorn scikit-learn pandas joblib

# Copy API files and specifically the pre-trained PKL artifacts
COPY models/ ./models/
COPY api/ ./api/

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
